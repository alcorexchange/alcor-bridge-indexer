# Alcor bridge indexer. Copy to .env and fill in; README.md, "Configuration",
# has every variable. Network facts (contract accounts, vault addresses, genesis
# times) come from src/chains/ and are not set here.

# ---------------------------------------------------------------- required

# Your Telos node's state-history socket: trace-history and
# finality-data-history on. Nobody serves this publicly.
SHIP_URL=ws://127.0.0.1:8080

# Telos HTTP API, comma-separated, tried in order: your node first, a
# full-history endpoint behind it for headers older than your block log.
TELOS_RPC=http://127.0.0.1:8888,https://telos.eosusa.io

# ---------------------------------------------------------------- the API

# Loopback, behind a reverse proxy with TLS.
HOST=127.0.0.1
PORT=8899
# Every route hangs off this prefix; empty means none.
API_BASE_PATH=/api/bridge
# The name in logs and /health.
INSTANCE=my-indexer

# ---------------------------------------------------------------- EVM chains

# Where log scanning starts on Ethereum: the block the vault was deployed in.
# Unset, it starts at the head and earlier deposits stay invisible.
EVM_FROM_BLOCK=26084601
# The same for BSC (56) and Polygon (137): the vault's creation block.
# EVM_FROM_BLOCK_56=
# EVM_FROM_BLOCK_137=

# Endpoints, comma-separated, longest retention first. The defaults are free
# public ones: fine for Ethereum and Polygon, not for BSC, where publicnode
# refuses old receipts and the Binance seeds refuse eth_getLogs.
# EXEC_URLS=
# BEACON_URLS=
# EXEC_URLS_56=https://bnb-mainnet.g.alchemy.com/v2/<key>
# ARCHIVE_URLS_56=https://bnb-mainnet.g.alchemy.com/v2/<key>
# EXEC_URLS_137=
# ARCHIVE_URLS_137=
# Every poll on a paid endpoint is a billed request.
# EVM_POLL_MS_56=20000

# ---------------------------------------------------------------- Antelope source chains (optional)

# WAX and XPR: a state-history socket turns the chain on (its blockroot keeper).
# WAX_SHIP_URL=ws://127.0.0.1:2224
# WAX_RPC=https://wax.eosusa.io
# WAX_HISTORY=https://wax.eosusa.io
# XPR_SHIP_URL=ws://127.0.0.1:4446
# XPR_RPC=https://proton.eosusa.io
# XPR_HISTORY=https://proton.eosusa.io

# Vaulta: an HTTP API turns it on; no keeper, no state-history.
# VAULTA_RPC=https://eos.api.eosnation.io
# VAULTA_HISTORY=https://eos.eosusa.io,https://eos.hyperion.eosrio.io

# ---------------------------------------------------------------- first run

# Check a computed root against the chain every 1000 leaves rather than 20000,
# so a bad frontier shows within minutes. Remove after the first day.
VERIFY_EVERY=1000

# ---------------------------------------------------------------- network

# An HTTP CONNECT proxy to retry a stalled request through; unset, no retry.
# PROXY_ALL=1 sends everything through it from the start.
# FALLBACK_PROXY=http://127.0.0.1:3128
# PROXY_ALL=1
