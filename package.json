{
  "name": "alcor-bridge-indexer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Alcor bridge indexer: follows Telos and the source chains, freezes a proof for every crossing, serves bridge state over HTTP.",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node services/indexer/index.ts",
    "check": "node services/indexer/index.ts --check",
    "test": "node --test 'tests/**/*.test.ts'",
    "tree": "node services/indexer/buildTree.ts",
    "withdrawal": "node scripts/build-withdrawal.ts",
    "import-artifact": "node scripts/import-artifact.ts"
  },
  "dependencies": {
    "@chainsafe/persistent-merkle-tree": "^1.3.1",
    "@ethereumjs/rlp": "^10.1.2",
    "@ethereumjs/trie": "^6.2.1",
    "@lodestar/params": "^1.34.0",
    "@lodestar/types": "^1.34.0",
    "@noble/curves": "^1.9.0",
    "@noble/hashes": "^1.8.0",
    "@wharfkit/antelope": "^1.0.13",
    "undici": "^7.0.0",
    "ws": "^8.18.0"
  }
}
